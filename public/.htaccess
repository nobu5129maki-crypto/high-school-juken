# 入口は index.php のログイン画面。中身はログイン後だけ gate.php が渡す。
DirectoryIndex index.php
Options -Indexes

<FilesMatch "^(auth\.php|index\.html)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^index\.php$ - [L]
RewriteRule ^gate\.php$ - [L]
RewriteRule ^$ index.php [L]
RewriteRule ^index\.html$ - [L]

# ホーム画面への追加は、Chrome がログインのクッキーなしで取りに来る。
# マニフェスト、192/512 アイコン、サービスワーカーだけ公開する。
RewriteRule ^(manifest\.webmanifest|sw\.js|icons/icon-192\.png|icons/icon-512\.png)$ - [END]

# 実在するファイル（スクリプトや画像）はログイン後だけ渡す
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} !/manifest\.webmanifest$ [NC]
RewriteCond %{REQUEST_URI} !/sw\.js$ [NC]
RewriteCond %{REQUEST_URI} !/icons/icon-192\.png$ [NC]
RewriteCond %{REQUEST_URI} !/icons/icon-512\.png$ [NC]
RewriteRule ^(.*)$ gate.php?hsj_path=$1 [B,L,QSA]

# /shindan などの画面パス。未ログインはログイン画面、ログイン後はアプリ。
RewriteCond %{REQUEST_URI} !/manifest\.webmanifest$ [NC]
RewriteCond %{REQUEST_URI} !/sw\.js$ [NC]
RewriteCond %{REQUEST_URI} !/icons/icon-192\.png$ [NC]
RewriteCond %{REQUEST_URI} !/icons/icon-512\.png$ [NC]
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <Files "manifest.webmanifest">
    Header set Content-Type "application/manifest+json; charset=UTF-8"
  </Files>
  <Files "sw.js">
    Header set Content-Type "application/javascript; charset=UTF-8"
  </Files>
</IfModule>
